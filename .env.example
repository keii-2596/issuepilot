# Required. Prefer a fine-grained token; GH_TOKEN is also accepted.
GITHUB_TOKEN=github_pat_xxx

# Optional discovery preferences.
ISSUEPILOT_MIN_STARS=5000
ISSUEPILOT_MAX_STARS=1000000
ISSUEPILOT_LANGUAGES=Python,TypeScript,JavaScript,Go,Rust
ISSUEPILOT_REPO_LIMIT=20
ISSUEPILOT_ISSUES_PER_REPO=5
ISSUEPILOT_MAX_REPO_IDLE_DAYS=180
ISSUEPILOT_EXCLUDED_TOPICS=awesome-list,books,free-programming-books,interview,interview-resources,resources,lists
ISSUEPILOT_MAX_ISSUE_IDLE_DAYS=365
ISSUEPILOT_MAX_ISSUE_AGE_DAYS=180
ISSUEPILOT_ISSUE_LABELS=good first issue,help wanted
ISSUEPILOT_ACTIVE_WORK_DAYS=45
ISSUEPILOT_DISCOVERY_CONCURRENCY=6
ISSUEPILOT_DISCOVERY_SCAN_PAGES=10
ISSUEPILOT_DISCOVERY_SORT=recommended
ISSUEPILOT_MAX_CHANGED_FILES=20
ISSUEPILOT_MAX_DIFF_BYTES=200000

# Optional Codex model override. Empty means your Codex default.
ISSUEPILOT_CODEX_MODEL=
ISSUEPILOT_CODEX_TIMEOUT_SECONDS=1800

# Publishing is locked unless you deliberately uncomment the next line.
# ISSUEPILOT_ALLOW_PUBLISH=I_UNDERSTAND
